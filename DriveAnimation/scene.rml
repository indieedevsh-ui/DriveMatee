            <!-- Sun -->
            <Shape x="520" y="100" name="Sun" id="0:190">
                <Ellipse originX="0.5" originY="0.5" width="70" height="70" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FFFFC800" name="C"/></Fill>
                <Stroke thickness="5" cap="round" join="round" name="Outline">
                    <SolidColor colorValue="FFE6A800" name="C"/>
                </Stroke>
            </Shape>
            <Shape x="520" y="100" name="SunGlow" id="0:191" opacity="0.35">
                <Ellipse originX="0.5" originY="0.5" width="100" height="100" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FFFFECB3" name="C"/></Fill>
            </Shape>
        </Node>

        <!-- State Machine -->
        <StateMachine name="State Machine 1" id="0:7">
            <StateMachineLayer name="Layer 1" id="0:8">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState>
                    <StateTransition stateToId="0:12"/>
                </EntryState>
                <AnimationState x="200" animationId="0:6" id="0:12"/>
            </StateMachineLayer>
        </StateMachine>

        <!-- Looping loading drive: ~1.5s -->
        <LinearAnimation loopValue="loop" duration="90" fps="60" name="DriveLoop" id="0:6">
            <!-- Car bounce + slight nose tilt -->
            <KeyedObject objectId="0:100">
                <KeyedProperty propertyKey="14">
                    <KeyFrameDouble value="340" frame="0" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="332" frame="22" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="340" frame="45" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="334" frame="68" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="340" frame="90"/>
                </KeyedProperty>
                <KeyedProperty propertyKey="15">
                    <KeyFrameDouble value="-0.04" frame="0" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.4" y1="0" x2="0.6" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.05" frame="30" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.4" y1="0" x2="0.6" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="-0.03" frame="60" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.4" y1="0" x2="0.6" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="-0.04" frame="90"/>
                </KeyedProperty>
            </KeyedObject>

            <!-- Wheels spin -->
            <KeyedObject objectId="0:120">
                <KeyedProperty propertyKey="15">
                    <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="6.2831855" frame="90"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:130">
                <KeyedProperty propertyKey="15">
                    <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="6.2831855" frame="90"/>
                </KeyedProperty>
            </KeyedObject>

            <!-- Road dashes scroll left -->
            <KeyedObject objectId="0:151">
                <KeyedProperty propertyKey="13">
                    <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="-120" frame="90"/>
                </KeyedProperty>
            </KeyedObject>

            <!-- Hills gentle parallax -->
            <KeyedObject objectId="0:170">
                <KeyedProperty propertyKey="13">
                    <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="-18" frame="90"/>
                </KeyedProperty>
            </KeyedObject>

            <!-- Clouds drift -->
            <KeyedObject objectId="0:180">
                <KeyedProperty propertyKey="13">
                    <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="28" frame="90"/>
                </KeyedProperty>
            </KeyedObject>

            <!-- Sun pulse -->
            <KeyedObject objectId="0:191">
                <KeyedProperty propertyKey="16">
                    <KeyFrameDouble value="1" frame="0" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="1.12" frame="45" interpolationType="cubic">
