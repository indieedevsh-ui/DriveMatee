            <!-- Windshield -->
            <Shape x="28" y="-30" name="Windshield" id="0:105">
                <Rectangle originX="0.5" originY="0.5" width="52" height="34" cornerRadiusTL="12" name="Path"/>
                <Fill name="Fill">
                    <LinearGradient startX="-20" startY="-10" endX="20" endY="14" name="Glass">
