<Rive version="1" kind="fragment">
    <!--
      Drive Mate — loading screen
      Duolingo-inspired: soft pastel world, chunky outlined car, looping drive + particles.
      Artboard 600×600. Draw order: first declared = on top.
    -->
    <Artboard defaultStateMachineId="0:7" styleId="0:5" width="600" height="600" name="LoadingDrive" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>

        <Fill name="Background">
            <LinearGradient startX="300" startY="0" endX="300" endY="600" name="SkyGrad">
                <GradientStop colorValue="FF9FE8FF" position="0" name="Top"/>
                <GradientStop colorValue="FFD7FFF0" position="0.52" name="Mid"/>
                <GradientStop colorValue="FFB8EFC4" position="1" name="Bot"/>
            </LinearGradient>
        </Fill>

        <!-- ========== FRONT: speed lines + spark particles ========== -->
        <Node x="0" y="0" name="FX" id="0:200">
            <!-- Speed lines (left of car) -->
            <Shape x="120" y="318" name="Speed1" id="0:201" opacity="0.85">
                <Rectangle originX="0.5" originY="0.5" width="54" height="6" cornerRadiusTL="3" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="C"/></Fill>
            </Shape>
            <Shape x="95" y="338" name="Speed2" id="0:202" opacity="0.55">
                <Rectangle originX="0.5" originY="0.5" width="40" height="5" cornerRadiusTL="2.5" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="C"/></Fill>
            </Shape>
            <Shape x="110" y="358" name="Speed3" id="0:203" opacity="0.7">
                <Rectangle originX="0.5" originY="0.5" width="48" height="5" cornerRadiusTL="2.5" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="C"/></Fill>
            </Shape>

            <!-- Exhaust puffs -->
            <Shape x="168" y="352" name="Puff1" id="0:210" opacity="0.55">
                <Ellipse originX="0.5" originY="0.5" width="22" height="22" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="C"/></Fill>
            </Shape>
            <Shape x="150" y="340" name="Puff2" id="0:211" opacity="0.35">
                <Ellipse originX="0.5" originY="0.5" width="16" height="16" name="Path"/>
