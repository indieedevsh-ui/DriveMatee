            </Shape>
            <Shape x="138" y="356" name="Puff3" id="0:212" opacity="0.25">
                <Ellipse originX="0.5" originY="0.5" width="12" height="12" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="C"/></Fill>
            </Shape>

            <!-- Sparkle stars -->
            <Shape x="430" y="250" name="Spark1" id="0:220" opacity="0.9">
                <Star originX="0.5" originY="0.5" width="18" height="18" points="4" innerRadius="0.38" cornerRadius="1" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FFFFF59D" name="C"/></Fill>
            </Shape>
            <Shape x="470" y="290" name="Spark2" id="0:221" opacity="0.7">
                <Star originX="0.5" originY="0.5" width="14" height="14" points="4" innerRadius="0.4" cornerRadius="1" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="C"/></Fill>
            </Shape>
            <Shape x="400" y="270" name="Spark3" id="0:222" opacity="0.55">
                <Star originX="0.5" originY="0.5" width="12" height="12" points="4" innerRadius="0.42" cornerRadius="1" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FFB2FF59" name="C"/></Fill>
            </Shape>
            <Shape x="490" y="230" name="Spark4" id="0:223" opacity="0.8">
                <Ellipse originX="0.5" originY="0.5" width="8" height="8" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FFFFF176" name="C"/></Fill>
