            <Shape x="300" y="520" name="RoadEdge" id="0:161">
                <Rectangle originX="0.5" originY="0.5" width="640" height="28" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FF455A64" name="C"/></Fill>
            </Shape>
        </Node>

        <!-- ========== HILLS / WORLD ========== -->
        <Node x="0" y="0" name="World" id="0:170">
            <Shape x="120" y="390" name="HillL" id="0:171">
                <Ellipse originX="0.5" originY="0.5" width="280" height="160" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FF7ED957" name="C"/></Fill>
            </Shape>
            <Shape x="420" y="395" name="HillR" id="0:172">
                <Ellipse originX="0.5" originY="0.5" width="320" height="170" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FF66BB6A" name="C"/></Fill>
            </Shape>
            <Shape x="280" y="400" name="HillM" id="0:173">
                <Ellipse originX="0.5" originY="0.5" width="240" height="140" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FF8BE06A" name="C"/></Fill>
            </Shape>

            <!-- Soft clouds -->
            <Node x="0" y="0" name="Clouds" id="0:180">
                <Shape x="110" y="120" name="Cloud1a" id="0:181">
                    <Ellipse originX="0.5" originY="0.5" width="70" height="44" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="C"/></Fill>
                </Shape>
                <Shape x="145" y="112" name="Cloud1b" id="0:182">
                    <Ellipse originX="0.5" originY="0.5" width="54" height="40" name="Path"/>
