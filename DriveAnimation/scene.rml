                </Shape>
                <Shape x="0" y="0" name="HubL" id="0:123">
                    <Ellipse originX="0.5" originY="0.5" width="10" height="10" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FF1F3D24" name="C"/></Fill>
                </Shape>
                <Shape x="0" y="0" name="RimL" id="0:122">
                    <Ellipse originX="0.5" originY="0.5" width="28" height="28" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FFFFC800" name="C"/></Fill>
                    <Stroke thickness="3.5" cap="round" join="round" name="Outline">
                        <SolidColor colorValue="FF1F3D24" name="C"/>
                    </Stroke>
                </Shape>
                <Shape x="0" y="0" name="TireL" id="0:121">
                    <Ellipse originX="0.5" originY="0.5" width="50" height="50" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FF263238" name="C"/></Fill>
                    <Stroke thickness="5" cap="round" join="round" name="Outline">
                        <SolidColor colorValue="FF1F3D24" name="C"/>
                    </Stroke>
                </Shape>
            </Node>

            <!-- Right wheel -->
            <Node x="58" y="52" name="WheelR" id="0:130">
                <Shape x="0" y="-9" name="SpokeR" id="0:134">
                    <Rectangle originX="0.5" originY="0.5" width="4" height="16" cornerRadiusTL="2" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FF1F3D24" name="C"/></Fill>
                </Shape>
                <Shape x="0" y="0" name="HubR" id="0:133">
                    <Ellipse originX="0.5" originY="0.5" width="10" height="10" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FF1F3D24" name="C"/></Fill>
                </Shape>
                <Shape x="0" y="0" name="RimR" id="0:132">
                    <Ellipse originX="0.5" originY="0.5" width="28" height="28" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FFFFC800" name="C"/></Fill>
                    <Stroke thickness="3.5" cap="round" join="round" name="Outline">
                        <SolidColor colorValue="FF1F3D24" name="C"/>
