            </Shape>

            <!-- Headlight (front of glow) -->
            <Shape x="92" y="10" name="Headlight" id="0:108">
                <Ellipse originX="0.5" originY="0.5" width="22" height="22" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FFFFF59D" name="C"/></Fill>
                <Stroke thickness="4" cap="round" join="round" name="Outline">
                    <SolidColor colorValue="FF1F3D24" name="C"/>
                </Stroke>
            </Shape>
            <Shape x="92" y="10" name="HeadlightGlow" id="0:109" opacity="0.45">
                <Ellipse originX="0.5" originY="0.5" width="34" height="34" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FFFFF176" name="C"/></Fill>
            </Shape>

            <!-- Smile grille -->
            <Shape x="70" y="28" name="Smile" id="0:112">
                <Rectangle originX="0.5" originY="0.5" width="36" height="10" cornerRadiusTL="5" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FF1F3D24" name="C"/></Fill>
            </Shape>

            <!-- Door line detail -->
            <Shape x="6" y="8" name="DoorLine" id="0:113" opacity="0.35">
                <Rectangle originX="0.5" originY="0.5" width="4" height="36" cornerRadiusTL="2" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FF1F3D24" name="C"/></Fill>
            </Shape>

            <!-- Main body -->
            <Shape x="0" y="18" name="Body" id="0:103">
                <Rectangle originX="0.5" originY="0.5" width="196" height="64" cornerRadiusTL="28" name="Path"/>
                <Fill name="Fill">
                    <LinearGradient startX="0" startY="-32" endX="0" endY="32" name="BodyGrad">
                        <GradientStop colorValue="FF7AE02A" position="0" name="Top"/>
                        <GradientStop colorValue="FF58CC02" position="0.55" name="Mid"/>
                        <GradientStop colorValue="FF46A302" position="1" name="Bot"/>
                    </LinearGradient>
                </Fill>
                <Stroke thickness="6" cap="round" join="round" name="Outline">
                    <SolidColor colorValue="FF1F3D24" name="C"/>
                </Stroke>
            </Shape>

            <!-- Rear bumper -->
            <Shape x="-88" y="18" name="RearBumper" id="0:102">
                <Rectangle originX="0.5" originY="0.5" width="28" height="26" cornerRadiusTL="8" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FF58CC02" name="C"/></Fill>
                <Stroke thickness="5" cap="round" join="round" name="Outline">
                    <SolidColor colorValue="FF1F3D24" name="C"/>
                </Stroke>
            </Shape>
            <!-- Tail light -->
            <Shape x="-94" y="8" name="TailLight" id="0:115">
                <Ellipse originX="0.5" originY="0.5" width="12" height="16" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FFFF4B4B" name="C"/></Fill>
                <Stroke thickness="3" cap="round" join="round" name="Outline">
                    <SolidColor colorValue="FF1F3D24" name="C"/>
                </Stroke>
            </Shape>

            <!-- Left wheel: hub/rim on top of tire -->
            <Node x="-58" y="52" name="WheelL" id="0:120">
                <Shape x="0" y="-9" name="SpokeL" id="0:124">
                    <Rectangle originX="0.5" originY="0.5" width="4" height="16" cornerRadiusTL="2" name="Path"/>
