                <Fill name="Fill"><SolidColor colorValue="FF81D4FA" name="C"/></Fill>
                <Stroke thickness="4" cap="round" join="round" name="Outline">
                    <SolidColor colorValue="FF1F3D24" name="C"/>
                </Stroke>
            </Shape>

            <!-- Cabin / roof -->
            <Shape x="8" y="-28" name="Cabin" id="0:104">
                <Rectangle originX="0.5" originY="0.5" width="118" height="52" cornerRadiusTL="22" name="Path"/>
                <Fill name="Fill">
                    <LinearGradient startX="0" startY="-26" endX="0" endY="26" name="CabinGrad">
