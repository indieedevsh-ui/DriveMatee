                <Fill name="Fill"><SolidColor colorValue="FFA1887F" name="C"/></Fill>
            </Shape>
        </Node>

        <!-- ========== CAR ========== -->
        <Node x="300" y="340" name="Car" id="0:100">
            <!-- Draw order: first = on top -->

            <!-- Roof light -->
            <Shape x="-10" y="-58" name="RoofLight" id="0:114">
                <Ellipse originX="0.5" originY="0.5" width="14" height="14" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FFFF4B4B" name="C"/></Fill>
                <Stroke thickness="3.5" cap="round" join="round" name="Outline">
                    <SolidColor colorValue="FF1F3D24" name="C"/>
