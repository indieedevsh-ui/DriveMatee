                </Shape>
                <Shape x="0" y="0" name="TireR" id="0:131">
                    <Ellipse originX="0.5" originY="0.5" width="50" height="50" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FF263238" name="C"/></Fill>
                    <Stroke thickness="5" cap="round" join="round" name="Outline">
                        <SolidColor colorValue="FF1F3D24" name="C"/>
                    </Stroke>
                </Shape>
            </Node>

            <!-- Soft ground shadow (back) -->
            <Shape x="0" y="58" name="Shadow" id="0:101" opacity="0.28">
                <Ellipse originX="0.5" originY="0.5" width="210" height="28" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FF2E4A35" name="C"/></Fill>
            </Shape>
        </Node>

        <!-- ========== ROAD ========== -->
        <Node x="0" y="0" name="RoadLayer" id="0:150">
            <!-- Dashes (animated scroll) -->
            <Node x="0" y="0" name="Dashes" id="0:151">
                <Shape x="60" y="430" name="Dash1" id="0:152">
                    <Rectangle originX="0.5" originY="0.5" width="56" height="14" cornerRadiusTL="7" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FFFFF59D" name="C"/></Fill>
