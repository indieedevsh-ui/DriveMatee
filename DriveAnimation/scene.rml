                <Shape x="420" y="90" name="Cloud2a" id="0:184">
                    <Ellipse originX="0.5" originY="0.5" width="64" height="40" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="C"/></Fill>
