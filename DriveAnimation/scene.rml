                <Shape x="540" y="430" name="Dash5" id="0:156">
                    <Rectangle originX="0.5" originY="0.5" width="56" height="14" cornerRadiusTL="7" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FFFFF59D" name="C"/></Fill>
