<Rive version="1" kind="fragment">
    <!--
      Drive Mate — ModeCar
      Side-view car with looping exhaust smoke / mode intro.
      Chunky outlined style like LoadingDrive, dark/neon-friendly lime.
      Artboard 600×600. Draw order: first declared = on top.
    -->
    <Artboard defaultStateMachineId="0:7" styleId="0:5" width="600" height="600" name="ModeCar" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>

        <Fill name="Background">
            <LinearGradient startX="300" startY="0" endX="300" endY="600" name="DarkGrad">
                <GradientStop colorValue="FF0B1210" position="0" name="Top"/>
                <GradientStop colorValue="FF122018" position="0.55" name="Mid"/>
                <GradientStop colorValue="FF0A100E" position="1" name="Bot"/>
            </LinearGradient>
        </Fill>

        <!-- ========== FX: speed lines + exhaust (front) ========== -->
        <Node x="0" y="0" name="FX" id="0:200">
            <Shape x="120" y="310" name="Speed1" id="0:201" opacity="0.8">
                <Rectangle originX="0.5" originY="0.5" width="52" height="6" cornerRadiusTL="3" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FFB2FF59" name="C"/></Fill>
            </Shape>
            <Shape x="95" y="330" name="Speed2" id="0:202" opacity="0.5">
                <Rectangle originX="0.5" originY="0.5" width="40" height="5" cornerRadiusTL="2.5" name="Path"/>
