            <Shape x="110" y="350" name="Speed3" id="0:203" opacity="0.65">
                <Rectangle originX="0.5" originY="0.5" width="46" height="5" cornerRadiusTL="2.5" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FFB2FF59" name="C"/></Fill>
            </Shape>

            <!-- Exhaust smoke puffs (looping drift) -->
            <Shape x="168" y="348" name="Puff1" id="0:210" opacity="0.55">
                <Ellipse originX="0.5" originY="0.5" width="26" height="26" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FFE8FFFB" name="C"/></Fill>
            </Shape>
            <Shape x="148" y="334" name="Puff2" id="0:211" opacity="0.4">
